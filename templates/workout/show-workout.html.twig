{% extends 'base.html.twig' %}

{% block title %}Entrainement{% endblock %}

{% block body %}
    <div class="h-[90vh] w-full bg-primary p-5">
        <button class="border-2 border-secondary py-1 px-2 text-base cursor-pointer text-secondary transition-transform duration-300 ease-in-out hover:scale-105" onClick="window.history.back();">
            Retour
        </button>
        <div class="flex justify-center items-center">
            <h1 class="text-5xl text-secondary">Entrainement : <span class="text-white">{{ workout.name }}</span></h1>
            <button id="favorite-btn" class="favorite-btn ml-3" data-id="{{ workout.id }}" aria-label="Ajouter aux favoris">
                <i class="fa-heart fa{{ isFavorite ? 's' : 'r' }}"></i>
            </button>
            {% if is_granted('workout_edit') %}
                <a href="{{path('create_workout')}}" id="edit-btn" class="edit-btn ml-3 text-white" aria-label="Modifier l'entrainement">
                    <i class="fa-solid fa-pen-to-square"></i>
                </a>
            {% endif %}
        </div>
        <div class="bg-darkblue h-screen">
            <h2 class="text-3xl text-secondary">Exercices :</h2>
            <div class="flex">
                {% for exercise in exercises %}
                    <a href="{{ path("show_exercise", {'id': exercise.id}) }}">
                        <div class="bg-primary m-3 shadow-lg text-secondary w-[12rem] transition-transform duration-300 ease-in-out hover:scale-105">
                            <div class="flex items-center justify-center">
                                <img src="/images/placeholder.png" alt="equipment-image">
                            </div>
                            <hr>
                            <div class="flex items-center justify-center">
                                {{ exercise.name }}
                            </div>
                        </div>
                    </a>
                {% endfor %}
            </div>
            <h2 class="text-3xl text-secondary">Muscles sollicités :</h2>
            <div class="flex">
                {% for muscle in muscles %}
                    <div class="bg-primary m-3 shadow-lg text-secondary w-[12rem]">
                        <div class="flex items-center justify-center">
                            <img src="/images/placeholder.png" alt="muscle-image">
                        </div>
                        <hr>
                        <div class="flex items-center justify-center">
                            {{ muscle.name }}
                        </div>
                    </div>
                {% endfor %}
            </div>
            <h2 class="text-3xl text-secondary">Équipment nécessaire :</h2>
            <div class="flex">
                {% if equipments | length > 0 %}
                    {% for equipment in equipments %}
                        <div class="bg-primary m-3 shadow-lg text-secondary w-[12rem]">
                            <div class="flex items-center justify-center">
                                <img src="/images/placeholder.png" alt="muscle-image">
                            </div>
                            <hr>
                            <div class="flex items-center justify-center">
                                {{ equipment.name }}
                            </div>
                        </div>
                    {% endfor %}
                {% else %}
                    <p class="text-xl ml-3 text-white"><i class="fa-solid fa-child-reaching"></i> Pas d'équipement nécessaire</p>
                {% endif %}

            </div>
        </div>
    </div>
{% endblock %}

